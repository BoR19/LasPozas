{
  "entities": {
    "User": {
      "title": "User",
      "description": "A registered community water customer/subscriber.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Customer ID (e.g. USR-1234)" },
        "name": { "type": "string", "description": "Full name of the subscriber" },
        "address": { "type": "string", "description": "Subscriber address" },
        "meter_id": { "type": "string", "description": "Water meter identification number" },
        "category": { "type": "string", "enum": ["Residencial", "Residencial Social", "Comercial", "Industrial"], "description": "Tariff category" },
        "estado": { "type": "string", "enum": ["activo", "suspendido", "baja"], "description": "Subscriber account status (activo, suspendido, or baja)" },
        "motivo_suspension": { "type": "string", "description": "Reason for suspension (Viaje, Mora, Solicitud cliente, Fuga, Otro)" },
        "fecha_suspension": { "type": "number", "description": "Suspension timestamp in milliseconds" },
        "fecha_reactivacion": { "type": "number", "description": "Reactivation timestamp in milliseconds" },
        "createdAt": { "type": "number", "description": "Creation timestamp in milliseconds" },
        "uuid": { "type": "string", "description": "Global unique identifier" },
        "updated_at": { "type": "number", "description": "Last update timestamp" },
        "version": { "type": "number", "description": "Record version" }
      },
      "required": ["id", "name", "address", "meter_id", "category", "uuid"]
    },
    "Medidor": {
      "title": "Medidor",
      "description": "Registered water meter device.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Meter code (e.g. MET-XXXX)" },
        "meter_id": { "type": "string", "description": "Meter code" },
        "user_id": { "type": "string", "description": "Referenced customer ID" },
        "categoria": { "type": "string", "description": "Category" },
        "lectura_inicial": { "type": "number", "description": "Initial reading in m3" },
        "fecha_instalacion": { "type": "number", "description": "Installation timestamp" },
        "estado": { "type": "string", "description": "Meter operational state" },
        "uuid": { "type": "string", "description": "Global unique identifier" },
        "updated_at": { "type": "number", "description": "Last update timestamp" },
        "version": { "type": "number", "description": "Record version" }
      },
      "required": ["id", "meter_id", "user_id", "uuid"]
    },
    "Reading": {
      "title": "Reading",
      "description": "Monthly water meter reading and consumption record.",
      "type": "object",
      "properties": {
        "user_id": { "type": "string", "description": "Referenced customer ID" },
        "medidor_id": { "type": "string", "description": "Referenced meter ID" },
        "factura_id": { "type": "string", "description": "Referenced invoice ID" },
        "previous_reading": { "type": "number", "description": "Previous meter reading in m3" },
        "current_reading": { "type": "number", "description": "Current meter reading in m3" },
        "consumption": { "type": "number", "description": "Calculated consumption in m3" },
        "date": { "type": "number", "description": "Reading date timestamp" },
        "status": { "type": "string", "enum": ["paid", "pending", "overdue"], "description": "Payment status" },
        "tipo_factura": { "type": "string", "description": "Type of invoice: regular, primera, or reconexion" },
        "detalle": { "type": "object", "description": "Detailed billing breakdown" },
        "uuid": { "type": "string", "description": "Global unique identifier" },
        "updated_at": { "type": "number", "description": "Last update timestamp" },
        "version": { "type": "number", "description": "Record version" }
      },
      "required": ["user_id", "previous_reading", "current_reading", "consumption", "date", "status", "uuid"]
    },
    "Factura": {
      "title": "Factura",
      "description": "Water bill or invoice record.",
      "type": "object",
      "properties": {
        "factura_id": { "type": "string", "description": "Invoice identifier (e.g. FAC-XXXX)" },
        "total": { "type": "number", "description": "Total amount to pay in Bs" },
        "consumo": { "type": "number", "description": "Water consumption in m3" },
        "estado": { "type": "string", "enum": ["pendiente", "pagado", "anulado"], "description": "Invoice payment state" },
        "usuario_id": { "type": "string", "description": "Customer ID" },
        "medidor_id": { "type": "string", "description": "Meter ID" },
        "lectura_id": { "description": "Referenced reading ID" },
        "fecha": { "type": "number", "description": "Invoice issue date timestamp" },
        "tipo_factura": { "type": "string", "description": "Type of invoice: regular, primera, or reconexion" },
        "tipo": { "type": "string", "enum": ["nueva", "normal", "reconexion"], "description": "Invoice type: nueva, normal, or reconexion" },
        "es_reconexion": { "type": "boolean", "description": "Whether this invoice was generated for reconnection" },
        "desglose": { "type": "object", "description": "Detailed billing breakdown (cargo_fijo, conexion, reconexion, base_m3, base_costo, exceso_m3, exceso_costo)" },
        "detalle": { "type": "object", "description": "Detailed billing breakdown" },
        "estado_pago": { "type": "string", "enum": ["pendiente", "pagado"], "description": "Payment status" },
        "metodo_pago": { "type": "string", "enum": ["efectivo", "qr_fie", "qr_altoke"], "description": "Payment method used" },
        "fecha_pago": { "type": "number", "description": "Payment timestamp" },
        "uuid": { "type": "string", "description": "Global unique identifier" },
        "updated_at": { "type": "number", "description": "Last update timestamp" },
        "version": { "type": "number", "description": "Record version" }
      },
      "required": ["factura_id", "total", "consumo", "estado", "usuario_id", "medidor_id", "fecha", "uuid"]
    },
    "Tariff": {
      "title": "Tariff",
      "description": "Water service pricing tier definitions.",
      "type": "object",
      "properties": {
        "categoria": { "type": "string", "description": "Category name" },
        "cargo_fijo_mensual": { "type": "number", "description": "Monthly fixed service fee" },
        "costo_m3_base": { "type": "number", "description": "Base rate per m3 (0-20 m3)" },
        "costo_m3_exceso": { "type": "number", "description": "Excess rate per m3 (>20 m3)" },
        "tarifa_conexion": { "type": "number", "description": "Connection fee" },
        "tarifa_reconexion": { "type": "number", "description": "Reconnection fee (50% of connection fee)" },
        "porcentaje_alcantarillado": { "type": "number", "description": "Sewer percentage surcharge" },
        "fecha_inicio": { "type": "number", "description": "Start validity timestamp" },
        "fecha_fin": { "type": "number", "description": "End validity timestamp" },
        "activa": { "type": "boolean", "description": "Whether this tariff version is currently active" },
        "uuid": { "type": "string", "description": "Global unique identifier" },
        "updated_at": { "type": "number", "description": "Last update timestamp" },
        "version": { "type": "number", "description": "Record version" }
      },
      "required": ["categoria", "cargo_fijo_mensual", "costo_m3_base", "costo_m3_exceso", "uuid"]
    },
    "PaymentConfig": {
      "title": "PaymentConfig",
      "description": "Payment configuration, static QR codes and bank details.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Configuration document identifier (e.g. pagos)" },
        "qr_fie_url": { "type": "string", "description": "Image data URL or URL for Banco FIE QR" },
        "qr_altoke_url": { "type": "string", "description": "Image data URL or URL for Altoke QR" },
        "titular": { "type": "string", "description": "Account holder name" },
        "banco": { "type": "string", "description": "Bank or institution name" },
        "uuid": { "type": "string", "description": "Global unique identifier" },
        "updated_at": { "type": "number", "description": "Last update timestamp" },
        "version": { "type": "number", "description": "Record version" }
      },
      "required": ["id", "titular", "banco", "uuid"]
    },
    "Staff": {
      "title": "Staff",
      "description": "System operator credentials and roles (admins and meter readers).",
      "type": "object",
      "properties": {
        "username": { "type": "string", "description": "Unique system username" },
        "password": { "type": "string", "description": "Obfuscated password hash" },
        "role": { "type": "string", "enum": ["admin", "lector"], "description": "Assigned access role" },
        "name": { "type": "string", "description": "Full staff name" },
        "uuid": { "type": "string", "description": "Global unique identifier" },
        "updated_at": { "type": "number", "description": "Last update timestamp" },
        "version": { "type": "number", "description": "Record version" }
      },
      "required": ["username", "password", "role", "name", "uuid"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Subscribers collection"
    },
    "/medidores/{medidorId}": {
      "schema": { "$ref": "#/entities/Medidor" },
      "description": "Water meters collection"
    },
    "/readings/{readingId}": {
      "schema": { "$ref": "#/entities/Reading" },
      "description": "Meter reading records"
    },
    "/facturas/{facturaId}": {
      "schema": { "$ref": "#/entities/Factura" },
      "description": "Invoices collection"
    },
    "/tarifas/{tarifaId}": {
      "schema": { "$ref": "#/entities/Tariff" },
      "description": "Active tariff structures"
    },
    "/configuracion/{configId}": {
      "schema": { "$ref": "#/entities/PaymentConfig" },
      "description": "System payment and general configuration"
    },
    "/staff/{staffId}": {
      "schema": { "$ref": "#/entities/Staff" },
      "description": "Staff credentials and roles"
    }
  }
}
